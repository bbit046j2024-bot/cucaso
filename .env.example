# ─────────────────────────────────────────────────────────────────────────────
# CUCASO Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Database (TiDB Cloud — MySQL-compatible) ──────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict
DATABASE_URL="mysql://USER:PASSWORD@gateway01.REGION.prod.aws.tidbcloud.com:4000/cucaso?sslaccept=strict"

# ── 2. Session & Application Security ─────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -hex 32
# Used to sign/encrypt iron-session cookies (HTTP-only, Secure, SameSite=Strict)
SESSION_SECRET="change-me-minimum-32-chars-random-secret-string"

# Cron / background job secret token for internal job runners
CRON_SECRET="change-me-cron-secret-token"

# ── 3. Application URL ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── 4. Cloudinary (Object Storage for uploads, media & receipts) ───────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ── 5. Safaricom Daraja M-Pesa API (STK Push & C2B) ───────────────────────────
# Developer Portal: https://developer.safaricom.co.ke/
# Set to "sandbox" for development/testing, "production" for live
DARAJA_ENVIRONMENT="sandbox"

# Daraja App Credentials from developer portal
DARAJA_CONSUMER_KEY="your_daraja_consumer_key"
DARAJA_CONSUMER_SECRET="your_daraja_consumer_secret"

# Lipa Na M-Pesa Online Shortcode (Business Shortcode):
# In sandbox, Safaricom uses test shortcode 174379
DARAJA_BUSINESS_SHORTCODE="174379"

# Lipa Na M-Pesa Online Passkey:
# In sandbox, Safaricom default test passkey is:
DARAJA_PASSKEY="bfb279f9aa9bdbaca158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919e07143c01f337e62493fe04c044f24"

# Secret query token appended to the webhook callback path to verify Safaricom caller authenticity
# Example: https://cucaso.org/api/daraja/stk-callback?token=your_secret_token
DARAJA_CALLBACK_SECRET="generate-a-secure-secret-token-here"

# Official Organization Paybill / Till (for manual bank / offline remissions)
DARAJA_PAYBILL_NUMBER="4082200"

# ── 6. Africa's Talking (SMS Notifications & Sandbox) ─────────────────────────
# Developer Portal: https://account.africastalking.com/
# In sandbox testing:
#   - Username MUST be: "sandbox"
#   - Use AT Web Simulator: https://simulator.africastalking.com:10010/
# In production:
#   - Username is your registered account username
#   - Sender ID is your approved Alphanumeric ID (e.g., "CUCASO")
AFRICAS_TALKING_USERNAME="sandbox"
AFRICAS_TALKING_API_KEY="atsk_your_africas_talking_api_key"
AFRICAS_TALKING_SENDER_ID=""

# ── 7. Transactional Email (Resend or SMTP) ───────────────────────────────────
# Supports Resend API (recommended) or standard SMTP (Gmail/SendGrid/SES)
EMAIL_FROM="CUCASO Giving <donations@cucaso.org>"
EMAIL_TREASURY="treasury@cucaso.org"
EMAIL_SECRETARIAT="info@cucaso.org"

# For Resend (https://resend.com/):
RESEND_API_KEY="re_xxxxxxxxxxxx"

# For SMTP (Alternative / Fallback):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_SECURE="false"

# ── 8. Super Admin Break-Glass (Recovery Only) ────────────────────────────────
# Documented in docs/SECURITY.md — Never commit to version control
# BREAK_GLASS_TOKEN="only-set-during-emergency-recovery"
