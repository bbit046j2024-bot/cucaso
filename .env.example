# ─────────────────────────────────────────────────────────────────────────────
# CUCASO Platform — Environment Variables
# Copy this file to .env.local and fill in your values.
# DO NOT commit .env or .env.local to version control.
# All variables are validated at startup via src/lib/env.ts (fail-fast).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (TiDB Cloud — MySQL-compatible) ──────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict
DATABASE_URL="mysql://USER:PASSWORD@gateway01.REGION.prod.aws.tidbcloud.com:4000/cucaso?sslaccept=strict"

# ── Session Security ──────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -hex 32
# Used to sign/encrypt iron-session cookies (HTTP-only, Secure, SameSite=Strict)
SESSION_SECRET="change-me-minimum-32-chars-random-secret-string"

# ── Cloudinary (Object Storage for uploads: endorsements, media, receipts) ───
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ── Safaricom Daraja (M-Pesa C2B Integration) ─────────────────────────────────
# Register at: https://developer.safaricom.co.ke/
# Sandbox mode until production credentials are approved.
DARAJA_CONSUMER_KEY="your_daraja_consumer_key"
DARAJA_CONSUMER_SECRET="your_daraja_consumer_secret"
DARAJA_PAYBILL_NUMBER="your_paybill_or_till_number"
DARAJA_PASSKEY="your_lipa_na_mpesa_passkey"
# Unique secret token appended to callback URL path — never share publicly
DARAJA_CALLBACK_SECRET="generate-a-random-secret-token-here"
# Set to "sandbox" for testing, "production" for live
DARAJA_ENVIRONMENT="sandbox"

# ── Africa's Talking (SMS Notifications) ─────────────────────────────────────
# Register at: https://account.africastalking.com/
AFRICAS_TALKING_API_KEY="your_api_key"
AFRICAS_TALKING_USERNAME="sandbox"  # or your production username
AFRICAS_TALKING_SENDER_ID="CUCASO"

# ── Email (Transactional) ─────────────────────────────────────────────────────
# Supports Resend, Nodemailer/SMTP, SendGrid. Configure in src/lib/email.ts.
EMAIL_FROM="noreply@cucaso.org"
# For Resend (recommended):
RESEND_API_KEY="re_xxxxxxxx"
# For SMTP (alternative):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your_user"
# SMTP_PASS="your_password"

# ── Application Configuration ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to "production" in production environments
NODE_ENV="development"

# ── Super Admin Break-Glass (Recovery Only) ───────────────────────────────────
# This is NOT a regular login. Documented in docs/SECURITY.md.
# Keep in a separate secrets manager; never in the repo.
# BREAK_GLASS_TOKEN="only-set-during-emergency-recovery"
